page {
  background: linear-gradient(120deg, #D9E9FF 0%, #E9DFFF 20%, #FFE2E8 42%, #DDF4E6 64%, #D8EDFF 82%, #D9E9FF 100%);
  background-size: 320% 320%;
  animation: bgFlow 22s ease-in-out infinite;
  color: #1F2430;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

/* 文字层：独立于毛玻璃，始终保持实心、锐利、无模糊 */
view,
text,
button,
input,
textarea {
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  -webkit-font-smoothing: antialiased;
  letter-spacing: 0;
}

.card,
.drawer .sheet,
.detail .d-card,
.tab-shell {
  color: #2F3650;
}

@keyframes bgFlow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

view, text, button, input, textarea {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  border-radius: 0;
  line-height: inherit;
  font-size: inherit;
}

button::after {
  border: none;
}

.card {
  background: #F6F4FA;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 88rpx;
  padding: 0 44rpx;
}

.btn-primary {
  background: #4F6EF7;
  color: #FFFFFF;
}

.btn-ghost {
  background: #EEF1FE;
  color: #4F6EF7;
}

.btn-block {
  display: flex;
  width: 100%;
}

.btn-hover {
  transform: scale(0.98);
}

.row {
  display: flex;
  align-items: center;
}

.fill {
  flex: 1;
  min-width: 0;
}

.muted {
  color: #6B6B70;
}

.small {
  font-size: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 36rpx 4rpx 18rpx;
  display: flex;
  align-items: center;
}

.tag {
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
  font-size: 22rpx;
}

.icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #EEF1FE;
  color: #4F6EF7;
  font-size: 34rpx;
  font-weight: 700;
  flex: none;
}

.icon-btn.warm {
  background: #FFF3E6;
  color: #E8590C;
}

.fx-wrap {
  position: relative;
}

.fx-float {
  position: absolute;
  right: 6rpx;
  top: -18rpx;
  z-index: 5;
  pointer-events: none;
  animation: fxFloat 0.9s ease-out forwards;
  font-size: 40rpx;
}

@keyframes fxFloat {
  0% { opacity: 0; transform: translateY(8rpx) scale(0.5); }
  25% { opacity: 1; transform: translateY(0) scale(1.15); }
  100% { opacity: 0; transform: translateY(-52rpx) scale(0.9); }
}

.pop-on {
  animation: popCheck 0.42s ease;
}

@keyframes popCheck {
  0% { transform: scale(1); }
  40% { transform: scale(1.32); }
  100% { transform: scale(1); }
}

.jump {
  display: inline-block;
  animation: fontJump 2.8s ease-in-out infinite;
}

@keyframes fontJump {
  0%, 100% { transform: translateY(0) scale(1); }
  28% { transform: translateY(-8rpx) scale(1.06); }
  52% { transform: translateY(0) scale(1); }
}
