.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 30rpx 12rpx 8rpx;
  padding-bottom: calc(8rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(120deg, rgba(214, 230, 255, 0.94), rgba(232, 223, 255, 0.95), rgba(255, 226, 232, 0.95), rgba(221, 244, 230, 0.95), rgba(255, 255, 255, 0.95));
  background-size: 300% 300%;
  animation: tabFlow 14s ease infinite;
  -webkit-backdrop-filter: blur(40rpx) saturate(1.5);
  backdrop-filter: blur(40rpx) saturate(1.5);
  border-top: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 -6rpx 24rpx rgba(110, 130, 210, 0.14);
  z-index: 100;
}

@keyframes tabFlow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  position: relative;
  transform: translateY(6rpx);
}

.tab-icon {
  font-size: 38rpx;
  line-height: 1.1;
  color: #5C6678;
  filter: drop-shadow(0 2rpx 2rpx rgba(255, 255, 255, 0.7));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.man-head {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: currentColor;
}

.man-body {
  width: 36rpx;
  height: 20rpx;
  border-radius: 20rpx 20rpx 4rpx 4rpx;
  background: currentColor;
  margin-top: 4rpx;
}

.tab-label {
  font-size: 22rpx;
  font-weight: 800;
  color: #5C6678;
  margin-top: 4rpx;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.9);
  letter-spacing: 0;
}

.tab-on .tab-icon {
  transform: translateY(-2rpx) scale(1.1);
  color: #3D5AF5;
}

.tab-on .tab-label {
  color: #3D5AF5;
  transform: scale(1.05);
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.95), 0 4rpx 8rpx rgba(61, 90, 245, 0.28);
}

.tab-dot {
  position: absolute;
  bottom: -6rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #3D5AF5;
}
