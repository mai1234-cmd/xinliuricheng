.page {
  padding: 28rpx 28rpx 100rpx;
}

.block {
  padding: 28rpx;
}

.label {
  font-size: 26rpx;
  color: #6B6B70;
  font-weight: 600;
  margin: 8rpx 0 12rpx;
}

.area {
  width: 100%;
  min-height: 260rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 29rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.input {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.ph {
  color: #9AA0A6;
}

.email-card {
  margin-top: 22rpx;
  padding: 24rpx 28rpx;
}

.email {
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

.copy {
  color: #3A7D5C;
  font-size: 26rpx;
  font-weight: 600;
  padding: 10rpx 20rpx;
  border-radius: 14rpx;
  background: #DFF3E6;
}

.submit {
  margin-top: 32rpx;
}

.tip {
  margin-top: 24rpx;
  line-height: 1.7;
}
