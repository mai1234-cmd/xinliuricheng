.page {
  position: relative;
  overflow: hidden;
  padding: 24rpx 28rpx 210rpx;
  padding-bottom: calc(210rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(210rpx + env(safe-area-inset-bottom));
}

.profile {
  position: relative;
  z-index: 1;
  overflow: visible;
  display: flex;
  align-items: center;
  padding: 34rpx 32rpx;
}

.profile .fill {
  padding-right: 170rpx;
}

.profile > .avatar-wrap,
.profile > .fill {
  position: relative;
  z-index: 1;
}

.brand-logo {
  position: absolute;
  top: 50%;
  right: 20rpx;
  transform: translateY(-50%);
  width: 150rpx;
  height: 150rpx;
  opacity: 0.2;
  z-index: 0;
  pointer-events: none;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6F89F8, #4F6EF7);
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
}

.avatar-wrap {
  position: relative;
  margin-right: 28rpx;
  flex: none;
}

.avatar-wrap .avatar {
  margin-right: 0;
}

.avatar-man {
  flex-direction: column;
}

.man-head {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #FFFFFF;
}

.man-body {
  width: 54rpx;
  height: 26rpx;
  border-radius: 28rpx 28rpx 6rpx 6rpx;
  background: #FFFFFF;
  margin-top: 6rpx;
}

.avatar-img {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #EEF1FE;
  display: block;
}


.nick {
  font-size: 34rpx;
  font-weight: 800;
  margin-top: 6rpx;
}

.ph {
  color: #B6BECB;
}

.mini-stats {
  margin-top: 20rpx;
}

.ms-cell {
  flex: 1;
  padding: 26rpx;
  text-align: center;
  margin-right: 20rpx;
}

.ms-cell:last-child {
  margin-right: 0;
}

.ms-num {
  font-size: 42rpx;
  font-weight: 800;
  color: #4F6EF7;
}

.ms-label {
  font-size: 22rpx;
  color: #9AA3B2;
  margin-top: 4rpx;
}

.pad {
  padding: 24rpx 28rpx;
}

.add-row {
  background: #F5F6FA;
  border-radius: 16rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
  margin-bottom: 12rpx;
}

.add-input {
  height: 72rpx;
  font-size: 28rpx;
}

.add-btn {
  background: #4F6EF7;
  color: #FFFFFF;
  border-radius: 999rpx;
  padding: 0 30rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.habit-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0F2F7;
}

.habit-item:last-child {
  border-bottom: none;
}

.h-icon {
  font-size: 36rpx;
  margin-right: 18rpx;
}

.habit-name {
  font-size: 30rpx;
  font-weight: 600;
}

.del {
  color: #E8590C;
  font-size: 24rpx;
  padding: 8rpx 12rpx;
}

.menu {
  padding: 6rpx 28rpx;
}

.menu-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F0F2F7;
  font-size: 30rpx;
  font-weight: 600;
}

.menu-item:last-child {
  border-bottom: none;
}

.danger {
  color: #E8590C;
}

.arrow {
  color: #C7CEDB;
  font-size: 36rpx;
}

.about {
  text-align: center;
  margin-top: 60rpx;
}
