.page {
  padding: 24rpx 28rpx 200rpx;
  padding-bottom: calc(200rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.cal-card {
  padding: 24rpx 12rpx 20rpx;
}

.cal-head {
  padding: 0 16rpx 16rpx;
}

.nav {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #F2F4FA;
  color: #4F6EF7;
  font-size: 44rpx;
  line-height: 76rpx;
  text-align: center;
  font-weight: 700;
}

.center {
  text-align: center;
}

.month {
  font-size: 34rpx;
  font-weight: 800;
}

.today-link {
  display: block;
  color: #4F6EF7;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.week-head,
.week-row {
  display: flex;
}

.wh {
  width: 14.28%;
  text-align: center;
  color: #9AA3B2;
  font-size: 24rpx;
  height: 56rpx;
  line-height: 56rpx;
}

.day-cell {
  width: 14.28%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 6rpx 4rpx;
  min-height: 170rpx;
  overflow: hidden;
  background: #F6F4FA;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}

.cell-sel {
  background: rgba(37, 99, 235, 0.04);
}

.cell-empty {
  background: transparent;
  border-color: transparent;
}

.day {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 52rpx;
  font-size: 24rpx;
  font-weight: 700;
  margin: 0 auto;
}

.day-badge {
  position: absolute;
  right: -10rpx;
  top: -8rpx;
  min-width: 26rpx;
  height: 26rpx;
  line-height: 26rpx;
  border-radius: 8rpx;
  background: #E8453C;
  color: #FFFFFF;
  font-size: 16rpx;
  font-weight: 700;
  text-align: center;
  padding: 0 4rpx;
  box-sizing: border-box;
}

.day-badge.work {
  background: #FB923C;
}

.day-badge.inline {
  position: static;
  display: inline-block;
  margin-left: 10rpx;
  vertical-align: middle;
}

.day-today {
  background: #2563EB;
  color: #FFFFFF;
  line-height: 52rpx;
}

.sel-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #2563EB;
  margin: 2rpx auto 0;
}

.day-marks {
  width: 100%;
  text-align: center;
  margin-top: 2rpx;
}

.dm {
  display: inline-block;
  font-size: 16rpx;
  line-height: 1.3;
  border-radius: 6rpx;
  padding: 0 4rpx;
  margin: 0 1rpx 2rpx;
  font-weight: 600;
}

.dm.term {
  color: #3A7D5C;
  background: #DFF3E6;
}

.dm.festival {
  color: #E8453C;
  background: #FDE8E8;
}

.dm.weekend {
  color: #6B6B70;
  background: #F0F1F2;
}

.sheet-marks {
  margin-top: 8rpx;
}

.day-blank {
  height: 68rpx;
}

.day-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-top: 4rpx;
  background: transparent;
}

.dot-on {
  background: #4F6EF7;
}

.cell-events {
  width: 100%;
  margin-top: 4rpx;
}

.cev {
  padding-left: 0;
  font-size: 17rpx;
  color: #4E5870;
  font-weight: 600;
  line-height: 1.35;
  margin-bottom: 3rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cev-dot {
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-right: 6rpx;
  vertical-align: middle;
}

.cev-done {
  color: #9AA0A6 !important;
  text-decoration: line-through;
}

.more {
  font-size: 16rpx;
  color: #4F6EF7;
  font-weight: 700;
  padding-left: 6rpx;
}

.add-link {
  color: #4F6EF7;
  font-size: 28rpx;
  font-weight: 700;
}

.tl-card {
  padding: 10rpx 28rpx;
}

.tl-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F0F2F7;
}

.tl-item:last-child {
  border-bottom: none;
}

.tl-line {
  width: 130rpx;
  display: flex;
  align-items: center;
  flex: none;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex: none;
}

.tl-time {
  font-size: 26rpx;
  font-weight: 600;
}

.tl-title {
  font-size: 30rpx;
  font-weight: 600;
}

.tl-cat {
  margin-top: 4rpx;
}

.tl-done {
  color: #B6BECB;
  text-decoration: line-through;
}

.check {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 3rpx solid #C7CEDB;
  margin-left: 16rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 800;
}

.check-on {
  background: #37C871;
  border-color: #37C871;
}

.empty {
  padding: 60rpx 40rpx;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  color: #6B7280;
  font-weight: 600;
  margin-bottom: 28rpx;
}

.empty-btn {
  margin-top: 8rpx;
}

.drawer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
}

.mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(40, 48, 70, 0.35);
  -webkit-backdrop-filter: blur(6rpx);
  backdrop-filter: blur(6rpx);
}

.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 66vh;
  background: rgba(250, 252, 255, 0.92);
  -webkit-backdrop-filter: blur(50rpx) saturate(1.6);
  backdrop-filter: blur(50rpx) saturate(1.6);
  border-radius: 40rpx 40rpx 0 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 -12rpx 40rpx rgba(100, 120, 200, 0.2);
  padding: 30rpx 28rpx 120rpx;
  box-sizing: border-box;
}

.sheet-head {
  padding-bottom: 20rpx;
}

.sheet-title {
  font-size: 40rpx;
  font-weight: 600;
}

.sheet-add {
  color: #4F6EF7;
  font-weight: 800;
  font-size: 28rpx;
  margin-left: 20rpx;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #EEF1F6;
  color: #77839A;
  text-align: center;
  line-height: 56rpx;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.mini-track {
  position: relative;
  height: 20rpx;
  border-radius: 999rpx;
  background: #EFF0F1;
  margin: 4rpx 0 22rpx;
  overflow: hidden;
}

.mini-block {
  position: absolute;
  top: 0;
  bottom: 0;
  border-radius: 999rpx;
}

.sheet-body {
  height: 58vh;
}

.d-item {
  background: #F6F4FA;
  border-radius: 22rpx;
  padding: 24rpx 22rpx;
  margin-bottom: 16rpx;
}

.d-bar {
  width: 8rpx;
  height: 56rpx;
  border-radius: 999rpx;
  margin-right: 18rpx;
  flex: none;
}

.d-title {
  font-size: 30rpx;
  font-weight: 600;
}

.d-done {
  color: #9AA0A6;
  text-decoration: line-through;
}

.warn {
  color: #EF4444;
  font-weight: 700;
}

.d-sub {
  margin-top: 4rpx;
}

.sheet-empty {
  text-align: center;
  color: #77839A;
  padding: 60rpx 0;
  font-size: 28rpx;
}

.sheet-empty-add {
  display: inline-block;
  color: #4F6EF7;
  font-weight: 800;
  margin-top: 20rpx;
}
