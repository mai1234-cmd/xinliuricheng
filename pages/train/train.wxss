.page {
  padding: 28rpx 28rpx 210rpx;
}

.hero {
  padding: 34rpx 32rpx;
  background: linear-gradient(135deg, #EEF1FE, #F6F0FF);
}

.brain-badge {
  width: 104rpx;
  height: 104rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  margin-right: 26rpx;
  box-shadow: 0 6rpx 18rpx rgba(91, 124, 251, 0.16);
}

.brain-num {
  font-size: 46rpx;
  font-weight: 800;
  color: #4F6EF7;
}

.right {
  text-align: right;
}

.count {
  font-size: 32rpx;
  font-weight: 800;
  margin-top: 4rpx;
}

.game-card {
  margin-bottom: 22rpx;
  padding: 26rpx 30rpx;
}

.game-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  margin-right: 24rpx;
  flex: none;
}

.game-name {
  font-size: 32rpx;
  font-weight: 800;
}

.game-best {
  color: #4F6EF7;
  margin-top: 6rpx;
  font-weight: 700;
}

.game-go {
  color: #4F6EF7;
  font-weight: 800;
  font-size: 26rpx;
  margin-left: 14rpx;
}

.more {
  text-align: center;
  margin-top: 30rpx;
}
